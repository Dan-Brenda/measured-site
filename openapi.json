          },
          {
            "name": "unit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "in",
                "cm"
              ],
              "default": "in",
              "description": "The unit both measurements are in: inches (in) or centimetres (cm)."
            },
            "description": "The unit both measurements are in: inches (in) or centimetres (cm)."
          }
        ],
        "responses": {
          "200": {
            "description": "Her size at the brand.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "engine",
                    "brand",
                    "measurements",
                    "your_size",
                    "band_and_cup",
                    "letter_sizes"
                  ],
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
                    "engine": {
                      "type": "object",
                      "description": "The extension version the engine is from, and the brands on file."
                    },
                    "method": {
                      "type": "string"
                    },
                    "brand": {
                      "type": "object"
                    },
                    "measurements": {
                      "type": "object"
                    },
                    "your_size": {
                      "type": "string"
                    },
                    "band_and_cup": {
                      "oneOf": [
                        {
                          "type": "object",
                          "description": "One answer as the extension's card gives it. A size is never given without its rating and badge.",
                          "required": [
                            "size",
                            "rating",
                            "badge",
                            "refused",
                            "why"
                          ],
                          "properties": {
                            "size": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "The size in the brand's own labels; null when refused."
                            },
                            "rating": {
                              "type": "string",
                              "description": "The engine's rating: Great match, Good match, Likely fits, Uncertain, check size chart; or a refusal: Outside this brand's range, Not on this brand's chart, Between this brand's chart rows, Beyond supported sizes."
                            },
                            "badge": {
                              "type": "string",
                              "description": "The words the card shows for the rating: Best Match, Strong Match, Possible Match, Limited Data; Not carried here, Not on their chart, Between chart sizes, Beyond our range."
                            },
                            "refused": {
                              "type": "boolean"
                            },
                            "why": {
                              "type": "string",
                              "description": "The card's own reason, word for word."
                            },
                            "band_edge": {
                              "type": [
                                "object",
                                "null"
                              ],
                              "description": "Where a brand's bands stop short of hers: which side, and its last band."
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "letter_sizes": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A required input is missing or not a number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No brand on file by that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Measurements the extension would not size (its own message says why).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this address; wait the seconds in Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
