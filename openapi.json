{
  "openapi": "3.1.0",
  "info": {
    "title": "Measured Size fit API",
    "version": "1.0.0",
    "summary": "Bra sizes from measurements, in each brand's own labels, with the confidence behind each.",
    "description": "Measured Size's sizing engine, the same code as its Chrome extension and calculator page. Free, no key. Every size comes with the engine's rating and reason; pass them on with the size. Nothing sent is stored or logged: only a count of requests per day per endpoint is kept. How it works: https://measuredsize.com/how-it-works.html. The published summary tables (the brand list and each brand's labels for each base size, as shown on the method page and returned by the API) are licensed under CC BY 4.0: credit \"Measured Size\" and link to https://measuredsize.com/how-it-works.html. The code, the research notes, the page readers and the full brand data are private and not licensed.",
    "termsOfService": "https://measuredsize.com/terms.html",
    "contact": {
      "name": "Measured Size",
      "email": "support@measuredsize.com",
      "url": "https://measuredsize.com/how-it-works.html"
    },
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://api.measuredsize.com"
    }
  ],
  "externalDocs": {
    "url": "https://measuredsize.com/how-it-works.html",
    "description": "How Measured Size works"
  },
  "paths": {
    "/v1/size": {
      "get": {
        "summary": "Her bra size from her measurements",
        "description": "Base size (band from the underbust to the nearest even band; cup from the bust, one US letter per inch), sister sizes one band each way, the UK size, and the EU and French sizes where their tables give the whole size. The confidence is the engine's rating of this size at a store it has no brand data for.",
        "operationId": "getSize",
        "parameters": [
          {
            "name": "underbust",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Snug around the ribcage, just under the bust, after breathing out. Decimals allowed.",
              "examples": [
                32
              ]
            },
            "description": "Snug around the ribcage, just under the bust, after breathing out. Decimals allowed."
          },
          {
            "name": "bust",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Around the fullest part of the bust, the tape flat and not pressing in. Decimals allowed.",
              "examples": [
                38
              ]
            },
            "description": "Around the fullest part of the bust, the tape flat and not pressing in. Decimals allowed."
          },
          {
            "name": "unit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "in",
                "cm"
              ],
              "default": "in",
              "description": "The unit both measurements are in: inches (in) or centimetres (cm)."
            },
            "description": "The unit both measurements are in: inches (in) or centimetres (cm)."
          }
        ],
        "responses": {
          "200": {
            "description": "Her size.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "engine",
                    "measurements",
                    "size",
                    "confidence"
                  ],
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
                    "engine": {
                      "type": "object",
                      "description": "The extension version the engine is from, and the brands on file."
                    },
                    "method": {
                      "type": "string"
                    },
                    "measurements": {
                      "type": "object"
                    },
                    "size": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "object"
                    },
                    "sister_sizes": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "international": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "usual_letter": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A required input is missing or not a number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No brand on file by that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Measurements the extension would not size (its own message says why).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this address; wait the seconds in Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
