        }
      }
    },
    "/v1/brand-size": {
      "get": {
        "summary": "Her size at one brand, in its own labels",
        "description": "Her size as the brand's band and cup listings label it, and as its letter listings do, each with the engine's rating and reason, or a refusal naming why (for example her band is outside the brand's range). Asked as for a listing known only by its brand: on a real listing its own chart and stock can change the answer.",
        "operationId": "getBrandSize",
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A brand name as shoppers write it (aliases accepted, any case), or an id from the brand list.",
              "examples": [
                "Wacoal"
              ]
            },
            "description": "A brand name as shoppers write it (aliases accepted, any case), or an id from the brand list."
          },
          {
            "name": "underbust",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Snug around the ribcage, just under the bust, after breathing out. Decimals allowed.",
