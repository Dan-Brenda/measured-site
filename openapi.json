    "/v1/translate": {
      "get": {
        "summary": "A known size at one brand, at another",
        "description": "Reads her band and cup label at from_brand back to Measured Size's base size through that brand's recorded labels, then gives to_brand's label for it. Rated no higher than Possible Match, since a label says less than measurements. Refuses a letter size, a label the brand's record doesn't give, or one that several sizes give.",
        "operationId": "translateSize",
        "parameters": [
          {
            "name": "from_brand",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The brand whose size she knows.",
              "examples": [
                "Wacoal"
              ]
            },
            "description": "The brand whose size she knows."
          },
          {
            "name": "size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Her band and cup size at from_brand, as that brand labels it.",
              "examples": [
                "34DD"
              ]
            },
            "description": "Her band and cup size at from_brand, as that brand labels it."
          },
          {
            "name": "to_brand",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The brand to translate the size into.",
              "examples": [
                "Curvy Kate"
              ]
            },
            "description": "The brand to translate the size into."
          }
        ],
        "responses": {
          "200": {
            "description": "The translated size, or a refusal with its reason.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "engine",
                    "refused",
                    "why"
                  ],
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
                    "engine": {
                      "type": "object",
                      "description": "The extension version the engine is from, and the brands on file."
                    },
                    "method": {
                      "type": "string"
                    },
                    "from": {
                      "type": "object"
                    },
                    "to": {
                      "type": "object"
                    },
                    "refused": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "why": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A required input is missing or not a number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No brand on file by that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Measurements the extension would not size (its own message says why).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this address; wait the seconds in Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "A known size at one brand, at another (JSON body)",
        "description": "Reads her band and cup label at from_brand back to Measured Size's base size through that brand's recorded labels, then gives to_brand's label for it. Rated no higher than Possible Match, since a label says less than measurements. Refuses a letter size, a label the brand's record doesn't give, or one that several sizes give.",
